BRAIN_PORT=3001
BRAIN_EMAIL=federico@becopenhagen.dk

# Generate with:  node hash-password.js
# Your password is never stored in plaintext.
BRAIN_PASSWORD_HASH=

# Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRAIN_SESSION_SECRET=

# Separate Anthropic workspace key, so brain cost is tracked apart from the app
ANTHROPIC_API_KEY_REPORTS=sk-ant-...

# Read-only path to the fleet app's database (for occupancy + guide questions)
FLEET_DB=/var/www/becopenhagen-fleet/data/fleet.db

# Optional: email the weekly briefing (leave unset to skip email)
BRAIN_SMTP_HOST=
BRAIN_SMTP_PORT=587
BRAIN_SMTP_USER=
BRAIN_SMTP_PASS=
BRAIN_EMAIL_TO=
